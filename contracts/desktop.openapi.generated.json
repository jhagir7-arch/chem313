              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Action"
      },
      "Cancel": {
